<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.fragments.NewResultFragment">

    <TextView
        android:id="@+id/new_result_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="100dp"
        android:text="@string/new_results"
        android:textColor="#000000"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewMinBorder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="@string/from_0_to"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/new_result_tv" />


    <EditText
        android:id="@+id/editTextMaxBorder"
        android:layout_width="250dp"
        android:layout_height="48dp"
        android:inputType="number"
        android:layout_marginTop="20dp"
        android:paddingEnd="10dp"
        android:paddingStart="10dp"
        android:hint="@string/max_border"
        android:background="#F1EBEB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewMinBorder" />

    <EditText
        android:id="@+id/editTextTextResult"
        android:inputType="text"
        android:layout_width="250dp"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:paddingEnd="10dp"
        android:paddingStart="10dp"
        android:hint="@string/result"
        android:background="#F1EBEB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextMaxBorder" />

    <Button
        android:id="@+id/buttonCreateResultBack"
        android:layout_width="175dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="@string/back"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:backgroundTint="#e76f51"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/buttonCreateResultToCatalog"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/buttonCreateResultToCatalog"
        android:layout_width="175dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="@string/continueButton"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:backgroundTint="#e76f51"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/buttonCreateResultBack" />

</androidx.constraintlayout.widget.ConstraintLayout>