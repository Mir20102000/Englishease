<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.fragments.SelectedLessonFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewSubjectNameStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:text="@string/theory_name"
                android:textAlignment="center"
                android:layout_gravity="center"
                android:textColor="#000000"
                android:textSize="34sp"
                android:textStyle="bold" />

            <com.example.englishease.presentation.TextViewEx
                android:id="@+id/theory_text_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="40dp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:fontFamily="serif"
                android:textAlignment="textStart"
                android:text="@string/lesson_text"
                android:textColor="#264653"
                android:textSize="18sp" />

            <Button
                android:id="@+id/buttonDeleteLesson"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#e76f51"
                android:text="Удалить урок"
                android:textAllCaps="false"
                android:textSize="17sp" />

        </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>

