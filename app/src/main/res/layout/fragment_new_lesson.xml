<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".presentation.fragments.NewLessonFragment">

    <TextView
        android:id="@+id/new_lesson"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:textSize="28sp"
        android:textColor="#000000"
        android:text="@string/new_lesson"
        app:layout_constraintBottom_toTopOf="@+id/new_lesson_name_edittext"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@+id/new_lesson_name_edittext"
        app:layout_constraintEnd_toEndOf="@+id/new_lesson_name_edittext"/>

    <EditText
        android:id="@+id/new_lesson_name_edittext"
        android:inputType="text"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:paddingEnd="10dp"
        android:paddingStart="10dp"
        android:background="#F1EBEB"
        android:hint="@string/name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/new_lesson" />

    <EditText
        android:id="@+id/lesson_desc_edittext"
        android:inputType="textMultiLine"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:gravity="top|start"
        android:layout_marginTop="10dp"
        android:paddingEnd="10dp"
        android:paddingStart="10dp"
        android:background="#F1EBEB"
        android:hint="@string/description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/new_lesson_name_edittext" />

    <EditText
        android:id="@+id/lesson_content_edittext"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:inputType="textMultiLine"
        android:layout_marginTop="10dp"
        android:paddingEnd="10dp"
        android:paddingStart="10dp"
        android:gravity="top|start"
        android:scrollbars="vertical"
        android:background="#F1EBEB"
        android:hint="@string/content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lesson_desc_edittext" />

    <Button
        android:id="@+id/save_new_lesson_btn"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_margin="100dp"
        android:backgroundTint="#e76f51"
        android:text="@string/save"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lesson_content_edittext" />



</androidx.constraintlayout.widget.ConstraintLayout>