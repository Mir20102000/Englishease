<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"

    android:orientation="vertical"
    tools:context=".presentation.fragments.MenuFragment">

    <TextView
        android:id="@+id/hello_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#ED8C3E"
        android:layout_gravity="top"
        android:gravity="center_horizontal"
        android:includeFontPadding="true"
        android:text="@string/menu"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/toLessonsFragmentCardView"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="170dp"
        card_view:cardBackgroundColor="#E8DFDF"
        card_view:cardCornerRadius="30dp">

        <TextView
            android:id="@+id/lessonsTextView"
            style="@style/TextAppearance.MaterialComponents.Headline4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="20dp"
            android:text="@string/lessons"
            android:textColor="#000000" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/toTestsFragmentCardView"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        card_view:cardBackgroundColor="#E8DFDF"
        card_view:cardCornerRadius="30dp">

        <TextView
            android:id="@+id/TestsTextView"
            style="@style/TextAppearance.MaterialComponents.Headline4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="20dp"
            android:text="@string/tests"
            android:textColor="#000000" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/toNewLessonFragmentCardView"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginTop="20dp"
        card_view:cardBackgroundColor="#E8DFDF"
        card_view:cardCornerRadius="30dp">

        <TextView
            android:id="@+id/newLessonTextView"
            style="@style/TextAppearance.MaterialComponents.Headline4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/new_lesson"
            android:textColor="#000000" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/toNewTestFragmentCardView"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        card_view:cardBackgroundColor="#E8DFDF"
        card_view:cardCornerRadius="30dp">

        <TextView
            android:id="@+id/newTestTextView"
            style="@style/TextAppearance.MaterialComponents.Headline4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="14dp"
            android:text="@string/new_test"
            android:textColor="#000000" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/to_auth_fragment_btn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center|bottom"
        android:layout_marginBottom="20dp"
        android:text="@string/exit"
        android:textStyle="bold"
        android:textColor="#FF64748B"
        android:textSize="14sp" />

