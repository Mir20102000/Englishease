<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".presentation.fragments.NewTestFragment">

    <TextView
        android:id="@+id/new_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:textSize="28sp"
        android:textColor="#000000"
        android:text="@string/new_test"
        app:layout_constraintBottom_toTopOf="@+id/test_name_edittext"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@+id/test_name_edittext"
        app:layout_constraintEnd_toEndOf="@+id/test_name_edittext"/>

    <EditText
        android:id="@+id/test_name_edittext"
        android:inputType="text"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:paddingEnd="10dp"
        android:paddingStart="10dp"
        android:background="#F1EBEB"
        android:hint="@string/name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/new_test" />

    <EditText
        android:id="@+id/question_count_edittext"
        android:inputType="number"
        android:layout_width="match_parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_height="48dp"
        android:paddingEnd="10dp"
        android:paddingStart="10dp"
        android:layout_marginTop="10dp"
        android:background="#F1EBEB"
        android:hint="@string/question_count_edittext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/test_name_edittext"
        tools:ignore="LabelFor" />

    <Button
        android:id="@+id/save_new_test_btn"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_margin="100dp"
        android:text="@string/save"
        android:textSize="17sp"
        android:backgroundTint="#e76f51"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>