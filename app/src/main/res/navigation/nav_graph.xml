<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authorizationFragment">

    <fragment
        android:id="@+id/authorizationFragment"
        android:name="com.example.englishease.presentation.fragments.AuthorizationFragment"
        android:label="fragment_authorization"
        tools:layout="@layout/fragment_authorization" >
        <action
            android:id="@+id/action_authorizationFragment_to_registrationFragment"
            app:destination="@id/registrationFragment" />
        <action
            android:id="@+id/action_authorizationFragment_to_menuFragment"
            app:destination="@id/menuFragment" />
    </fragment>
    <fragment
        android:id="@+id/registrationFragment"
        android:name="com.example.englishease.presentation.fragments.RegistrationFragment"
        android:label="fragment_registration"
        tools:layout="@layout/fragment_registration" >
        <action
            android:id="@+id/action_registrationFragment_to_authorizationFragment"
            app:destination="@id/authorizationFragment" />
    </fragment>
    <fragment
        android:id="@+id/theoryFragment"
        android:name="com.example.englishease.presentation.fragments.TheoryFragment"
        android:label="fragment_theory"
        tools:layout="@layout/fragment_theory" >
        <action
            android:id="@+id/action_theoryFragment_to_selectedTheoryFragment"
            app:destination="@id/selectedTheoryFragment" />
        <action
            android:id="@+id/action_theoryFragment_to_menuFragment"
            app:destination="@id/menuFragment" />
    </fragment>
    <fragment
        android:id="@+id/selectedTheoryFragment"
        android:name="com.example.englishease.presentation.fragments.SelectedTheoryFragment"
        android:label="fragment_selected_theory"
        tools:layout="@layout/fragment_selected_theory" >
        <action
            android:id="@+id/action_selectedTheoryFragment_to_selectedTestFragment"
            app:destination="@id/selectedTestFragment" />
        <action
            android:id="@+id/action_selectedTheoryFragment_to_selectedTestResultFragment"
            app:destination="@id/selectedTestResultFragment" />
    </fragment>
    <fragment
        android:id="@+id/selectedTestFragment"
        android:name="com.example.englishease.presentation.fragments.SelectedTestFragment"
        android:label="fragment_selected_test"
        tools:layout="@layout/fragment_selected_test" >
        <action
            android:id="@+id/action_selectedTestFragment_to_resultFragment"
            app:destination="@id/resultFragment" />
    </fragment>
    <fragment
        android:id="@+id/selectedTestResultFragment"
        android:name="com.example.englishease.presentation.fragments.SelectedTestResultFragment"
        android:label="fragment_selected_test_result"
        tools:layout="@layout/fragment_selected_test_result" >
        <action
            android:id="@+id/action_selectedTestResultFragment_to_theoryFragment"
            app:destination="@id/theoryFragment" />
    </fragment>
    <fragment
        android:id="@+id/resultFragment"
        android:name="com.example.englishease.presentation.fragments.ResultFragment"
        android:label="fragment_result"
        tools:layout="@layout/fragment_result" >
        <action
            android:id="@+id/action_resultFragment_to_selectedTestResultFragment"
            app:destination="@id/selectedTestResultFragment" />
        <action
            android:id="@+id/action_resultFragment_to_theoryFragment"
            app:destination="@id/theoryFragment" />
    </fragment>
    <fragment
        android:id="@+id/lessonsFragment"
        android:name="com.example.englishease.presentation.fragments.LessonsFragment"
        android:label="fragment_lessons"
        tools:layout="@layout/fragment_lessons" >
        <action
            android:id="@+id/action_lessonsFragment_to_selectedLessonFragment"
            app:destination="@id/selectedLessonFragment" />
        <action
            android:id="@+id/action_lessonsFragment_to_menuFragment"
            app:destination="@id/menuFragment" />
    </fragment>
    <fragment
        android:id="@+id/menuFragment"
        android:name="com.example.englishease.presentation.fragments.MenuFragment"
        android:label="fragment_menu"
        tools:layout="@layout/fragment_menu" >
        <action
            android:id="@+id/action_menuFragment_to_lessonsFragment"
            app:destination="@id/lessonsFragment" />
        <action
            android:id="@+id/action_menuFragment_to_theoryFragment"
            app:destination="@id/theoryFragment" />
        <action
            android:id="@+id/action_menuFragment_to_newLessonFragment"
            app:destination="@id/newLessonFragment" />
        <action
            android:id="@+id/action_menuFragment_to_newTestFragment"
            app:destination="@id/newTestFragment" />
    </fragment>
    <fragment
        android:id="@+id/selectedLessonFragment"
        android:name="com.example.englishease.presentation.fragments.SelectedLessonFragment"
        android:label="fragment_selected_lesson"
        tools:layout="@layout/fragment_selected_lesson" />
    <fragment
        android:id="@+id/newLessonFragment"
        android:name="com.example.englishease.presentation.fragments.NewLessonFragment"
        android:label="fragment_new_lesson"
        tools:layout="@layout/fragment_new_lesson" >
        <action
            android:id="@+id/action_newLessonFragment_to_menuFragment"
            app:destination="@id/menuFragment" />
    </fragment>
    <fragment
        android:id="@+id/newQuestionFragment"
        android:name="com.example.englishease.presentation.fragments.NewQuestionFragment"
        android:label="fragment_new_question"
        tools:layout="@layout/fragment_new_question" >
        <action
            android:id="@+id/action_newQuestionFragment_to_createResultFragment"
            app:destination="@id/createResultFragment" />
    </fragment>
    <fragment
        android:id="@+id/newTestFragment"
        android:name="com.example.englishease.presentation.fragments.NewTestFragment"
        android:label="fragment_new_test"
        tools:layout="@layout/fragment_new_test" >
        <action
            android:id="@+id/action_newTestFragment_to_newQuestionFragment"
            app:destination="@id/newQuestionFragment" />
    </fragment>
    <fragment
        android:id="@+id/createResultFragment"
        android:name="com.example.englishease.presentation.fragments.CreateResultFragment"
        android:label="fragment_create_result"
        tools:layout="@layout/fragment_create_result" />
</navigation>